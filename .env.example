# Copy to backend/.env and fill in real values
PORT=5000

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=arogyaai

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRATION=7d

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash,gemini-flash-lite-latest
GOOGLE_CLOUD_PROJECT=

FRONTEND_URL=http://localhost:5173

# Batch 5: Emergency / SOS — both configurable per deployment/region.
EMERGENCY_SERVICE_NUMBER=112
EMERGENCY_CONTACT_NUMBER=
